rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Materials collection: Anyone can read; anyone can create/update/delete (in public blog with teacher app-level protection)
    match /materials/{materialId} {
      allow read, write: if true;
    }
    
    // Comments collection: Anyone can read and post comments
    match /comments/{commentId} {
      allow read, write: if true;
    }
    
    // Notifications collection: Anyone can read and broadcast
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
    
    // Submissions collection: Anyone can submit quiz answers and read results
    match /submissions/{submissionId} {
      allow read, write: if true;
    }
  }
}
